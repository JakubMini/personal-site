---
// The startup animation's cover: an ink screen where a vinyl record is cut,
// spins up and rolls off to uncover the page. scripts/intro.ts plays it and
// scripts/vinyl.ts draws the record.
//
// The inline script runs before the hero is parsed, so the cover is up from
// the first paint. Without JavaScript, under reduced motion, or when the
// address names a section, it never sets has-intro and the cover stays hidden.
import { intro } from '../data/site';
---

<script is:inline>
  if (!location.hash && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    document.documentElement.classList.add('has-intro');
  }
</script>
<div class="intro" aria-hidden="true">
  <canvas class="intro-record" width="2" height="2" data-label={JSON.stringify(intro.label)}></canvas>
  <p class="intro-log">› <span data-log={JSON.stringify(intro.log)}>{intro.log[0]}</span></p>
  <p class="intro-speed">00.0 rpm</p>
</div>
