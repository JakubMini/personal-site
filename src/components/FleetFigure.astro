---
// The Minimal fleet architecture, interactive: pick a flow to watch it run,
// or select any part. Without JS it is the map plus each flow as a list;
// scripts/fleet-figure.ts brings the controls, the packet and the details.
import { BUS, EDGES, FLOWS, OVERVIEW, PARTS, TCU_BOX, ZONES } from '../data/fleet';

const d = (pts: readonly (readonly [number, number])[]) => pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x} ${y}`).join(' ');
---

<div class="fleet" data-fleet>
  <div class="fleet-bar" aria-label="Flows">
    <div class="fleet-tabs" role="tablist">
      {
        FLOWS.map((f, i) => (
          <button type="button" role="tab" class="fleet-tab" aria-selected={i === 0 ? 'true' : 'false'} data-flow={i}>
            {f.title}
          </button>
        ))
      }
    </div>
    <div class="fleet-ctl">
      <button type="button" class="fleet-btn" data-prev aria-label="Previous step">←</button>
      <button type="button" class="fleet-btn fleet-play" data-play>Pause</button>
      <button type="button" class="fleet-btn" data-next aria-label="Next step">→</button>
      <span class="fleet-count" data-count></span>
    </div>
  </div>

  <div class="fleet-scroll">
    <svg class="fleet-svg" viewBox="0 0 1200 600" aria-labelledby="fleet-title" role="group">
      <title id="fleet-title">Minimal fleet architecture: build and release, cloud, and vehicle</title>

      {
        ZONES.map((z) => (
          <g class="fz">
            <rect x={z.x} y={z.y} width={z.w} height={z.h} rx="12" />
            <text x={z.x + 18} y={z.y - 12}>{z.label}</text>
          </g>
        ))
      }

      <rect class="fz-tcu" x={TCU_BOX.x} y={TCU_BOX.y} width={TCU_BOX.w} height={TCU_BOX.h} rx="10"></rect>
      <text class="fz-tcu-label" x={TCU_BOX.x + 16} y={TCU_BOX.y + 22}>{TCU_BOX.label}</text>

      <g class="fe-all">{Object.entries(EDGES).map(([id, pts]) => <path class="fe" d={d(pts)} data-edge={id} />)}</g>

      <line class="fbus" x1={BUS.x1} y1={BUS.y} x2={BUS.x2} y2={BUS.y} data-edge-bus></line>
      <line class="fbus" x1={BUS.x1} y1={BUS.y + BUS.gap} x2={BUS.x2} y2={BUS.y + BUS.gap}></line>
      <text class="fbus-label" x={BUS.x1 + 16} y={BUS.y - 10}>{BUS.label}</text>

      {
        PARTS.map((p) => (
          <g class={`fp fp-${p.kind}`} data-part={p.id} role="button" tabindex="0" aria-label={`${p.label}: ${p.detail}`}>
            <rect class="fp-box" x={p.x} y={p.y} width={p.w} height={p.h} rx={p.kind === 'node' ? 10 : 7} />
            {p.kind === 'node' && (
              <>
                <text class="fp-title" x={p.x + 18} y={p.y + 27}>{p.label}</text>
                <text class="fp-sub" x={p.x + 18} y={p.y + 47}>{p.sub}</text>
              </>
            )}
            {p.kind === 'chip' && (
              <text class="fp-chip" x={p.x + p.w / 2} y={p.y + p.h / 2 + 4} text-anchor="middle">{p.label}</text>
            )}
            {p.kind === 'ecu' && (
              <>
                <text class="fp-ecu" x={p.x + p.w / 2} y={p.y + 18} text-anchor="middle">{p.label}</text>
                <rect class="fp-slot fp-slot-boot" x={p.x + 5} y={p.y + 28} width={p.w - 10} height="18" rx="3" />
                <text class="fp-slot-t" x={p.x + p.w / 2} y={p.y + 41} text-anchor="middle">boot</text>
                <rect class="fp-slot fp-slot-dl" x={p.x + 5} y={p.y + 50} width={p.w - 10} height="18" rx="3" data-slot="download" />
                <text class="fp-slot-t" x={p.x + p.w / 2} y={p.y + 63} text-anchor="middle">dl</text>
                <rect class="fp-slot fp-slot-run" x={p.x + 5} y={p.y + 72} width={p.w - 10} height="18" rx="3" data-slot="run" />
                <text class="fp-slot-t" x={p.x + p.w / 2} y={p.y + 85} text-anchor="middle">app</text>
              </>
            )}
          </g>
        ))
      }
      <text class="fbus-label" x="842" y="560">Six ECUs, each with its own bootloader</text>

      <g class="fpkt" data-packet opacity="0">
        <circle r="6"></circle>
        <rect class="fpkt-tag" x="10" y="-22" width="60" height="18" rx="9"></rect>
        <text x="40" y="-9" text-anchor="middle"></text>
      </g>
    </svg>
  </div>

  <div class="fleet-foot">
    <p class="fleet-caption" aria-live="polite" data-caption>{FLOWS[0].steps[0].caption}</p>
    <div class="fleet-detail" data-detail aria-live="polite">
      <p class="fleet-detail-title" data-detail-title>{OVERVIEW.title}</p>
      <p class="fleet-detail-body" data-detail-body>{OVERVIEW.detail}</p>
      <p class="fleet-detail-tags" data-detail-tags></p>
    </div>
  </div>

  <div class="fleet-static">
    {
      FLOWS.map((f) => (
        <div>
          <p class="fleet-static-title">{f.title}</p>
          <ol>{f.steps.map((s) => <li>{s.caption}</li>)}</ol>
        </div>
      ))
    }
  </div>
</div>

<script>
  import { initFleet } from '../scripts/fleet-figure';
  document.querySelectorAll<HTMLElement>('[data-fleet]').forEach(initFleet);
</script>
