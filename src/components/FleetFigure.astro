---
// The Minimal fleet architecture: build, cloud, TCU and ECUs, a release going
// out and data coming back (scripts/fleet-figure.ts plays it on a loop). Drawn
// wide for desktops and tall for narrow screens; CSS shows one. Without JS, or
// under reduced motion: the still drawing, and the steps as a list.
import { CHECKS, CLOUD, ECUS, ICONS, LAYOUTS, OTA_LINES, STEPS, type LayoutName, type Pt } from '../data/fleet';

const names: LayoutName[] = ['wide', 'tall'];
const d = (pts: readonly Pt[]) => pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x} ${y}`).join(' ');

// An arrowhead with its tip on `b`, pointing from `a`.
const head = (a: Pt, b: Pt) => {
  const dx = Math.sign(b[0] - a[0]);
  const dy = Math.sign(b[1] - a[1]);
  const [x, y] = b;
  const [bx, by] = [x - dx * 7, y - dy * 7];
  return `M${x} ${y}L${bx - dy * 4.5} ${by + dx * 4.5}L${bx + dy * 4.5} ${by - dx * 4.5}Z`;
};
---

<div class="fleet" data-fleet>
  {
    names.map((name) => {
      const L = LAYOUTS[name];
      const B = L.boxes;
      const wide = name === 'wide';
      const icon = (id: string, x: number, y: number) => (
        <g class="fi" transform={`translate(${x} ${y})`}>
          <path d={ICONS[id].line} />
          {ICONS[id].fill && <path class="fi-fill" d={ICONS[id].fill} />}
        </g>
      );
      return (
        <svg
          class={`fleet-svg fleet-${name}`}
          viewBox={`0 0 ${L.width} ${L.height}`}
          role="img"
          aria-labelledby={`fleet-title-${name} fleet-desc-${name}`}
          data-layout={name}
        >
          <title id={`fleet-title-${name}`}>Minimal fleet architecture</title>
          <desc id={`fleet-desc-${name}`}>{STEPS.map((s) => s.caption).join(' ')}</desc>

          {L.headings.map((h) => <text class="fh" x={h.x} y="30">{h.text}</text>)}

          {/* Build */}
          <g class="fp" data-part="ci">
            <rect class="fp-box" x={B.ci.x} y={B.ci.y} width={B.ci.w} height={B.ci.h} rx="10" />
            {icon('actions', B.ci.x + (wide ? 16 : 12), B.ci.y + (wide ? 16 : 12))}
            <text class="ft" x={B.ci.x + (wide ? 16 : 58)} y={B.ci.y + (wide ? 76 : 36)}>GitHub Actions</text>
            {CHECKS.map((c, i) => {
              const w = wide ? B.ci.w - 32 : (B.ci.w - 24 - 3 * 8) / 4;
              const x = B.ci.x + (wide ? 16 : 12 + i * (w + 8));
              const y = B.ci.y + (wide ? 92 + i * 34 : 56);
              return (
                <g class="fpill">
                  <rect x={x} y={y} width={w} height="26" rx="13" />
                  <text x={wide ? x + 14 : x + w / 2} y={y + 17.5} text-anchor={wide ? 'start' : 'middle'}>{c}</text>
                </g>
              );
            })}
          </g>

          {/* Cloud */}
          {CLOUD.map((c) => {
            const b = B[c.id];
            return (
              <g class="fp" data-part={c.id}>
                <rect class="fp-box" x={b.x} y={b.y} width={b.w} height={b.h} rx="10" />
                {wide ? (
                  <>
                    {icon(c.icon, b.x + 14, b.y + (b.h - 36) / 2)}
                    <text class="ft" x={b.x + 62} y={b.y + b.h / 2 - 2}>{c.title}</text>
                    <text class="fsub" x={b.x + 62} y={b.y + b.h / 2 + 16}>{c.sub}</text>
                  </>
                ) : (
                  <>
                    {icon(c.icon, b.x + (b.w - 36) / 2, b.y + 10)}
                    <text class="ft ft-tile" x={b.x + b.w / 2} y={b.y + 64} text-anchor="middle">{c.title}</text>
                  </>
                )}
              </g>
            );
          })}

          {/* TCU */}
          <rect class="fp-frame" x={B.tcu.x} y={B.tcu.y} width={B.tcu.w} height={B.tcu.h} rx="12" />
          {L.tcuLabel && <text class="fh fh-tcu" x={L.tcuLabel[0]} y={L.tcuLabel[1]} text-anchor="middle">TCU · Raspberry Pi</text>}
          <g class="fp fp-chip" data-part="ota">
            <rect class="fp-box" x={B.ota.x} y={B.ota.y} width={B.ota.w} height={B.ota.h} rx="8" />
            <text class={wide ? 'ft' : 'ft ft-small'} x={B.ota.x + (wide ? 16 : 12)} y={B.ota.y + (wide ? 28 : 22)}>OTA service</text>
            {OTA_LINES.map((l, i) => (
              <text class={wide ? 'fsub' : 'fsub fsub-small'} x={B.ota.x + (wide ? 16 : 12)} y={B.ota.y + (wide ? 58 + i * 20 : 42 + i * 15)}>{l}</text>
            ))}
          </g>
          <g class="fp fp-chip" data-part="os">
            <rect class="fp-box" x={B.os.x} y={B.os.y} width={B.os.w} height={B.os.h} rx="8" />
            {wide ? (
              <>
                <text class="ft" x={B.os.x + 16} y={B.os.y + 28}>balenaOS</text>
                <text class="fsub" x={B.os.x + 16} y={B.os.y + 47}>runs every container</text>
              </>
            ) : (
              <text class="ft ft-tile" x={B.os.x + B.os.w / 2} y={B.os.y + B.os.h / 2 + 4} text-anchor="middle">balenaOS</text>
            )}
          </g>
          <g class="fp fp-chip" data-part="other">
            <rect class="fp-box" x={B.other.x} y={B.other.y} width={B.other.w} height={B.other.h} rx="8" />
            <text class={wide ? 'ft' : 'ft ft-small'} x={B.other.x + (wide ? 16 : 12)} y={B.other.y + (wide ? 28 : 22)}>Other services</text>
            {wide ? (
              <text class="fsub" x={B.other.x + 16} y={B.other.y + 50}>vehicle data, diagnostics</text>
            ) : (
              ['vehicle data,', 'diagnostics'].map((l, i) => (
                <text class="fsub fsub-small" x={B.other.x + 12} y={B.other.y + 42 + i * 15}>{l}</text>
              ))
            )}
          </g>
          <g class="fp fp-chip" data-part="can">
            <rect class="fp-box" x={B.can.x} y={B.can.y} width={B.can.w} height={B.can.h} rx="8" />
            {wide ? (
              <text class="ft" transform={`translate(${B.can.x + B.can.w / 2 + 5} ${B.can.y + B.can.h / 2}) rotate(-90)`} text-anchor="middle">CAN</text>
            ) : (
              <text class="ft ft-small" x={B.can.x + B.can.w / 2} y={B.can.y + B.can.h / 2 + 4.5} text-anchor="middle">CAN</text>
            )}
          </g>

          {/* CAN bus */}
          <g class="fbus" data-part="bus">
            <path class="fbus-line" d={d(L.bus.pts)} />
            {L.bus.taps.map(([x, y]) => <circle cx={x} cy={y} r="3.5" />)}
            {L.bus.vertical ? (
              <text class="fwl" transform={`translate(${L.bus.label[0]} ${L.bus.label[1]}) rotate(-90)`} text-anchor="middle">CAN bus</text>
            ) : (
              <text class="fwl" x={L.bus.label[0]} y={L.bus.label[1]} text-anchor="middle">CAN bus</text>
            )}
          </g>

          {/* ECUs: bootloader, application, and the slot a new image streams into */}
          {ECUS.map((e) => {
            const b = B[e.id];
            const pad = wide ? 16 : 10;
            const { top, boot, app, dl, gap } = L.bars;
            const x = b.x + pad;
            const w = b.w - 2 * pad;
            const y1 = b.y + top;
            const y2 = y1 + boot + gap;
            const y3 = y2 + app + gap;
            return (
              <g class="fp fp-chip" data-part={e.id}>
                <rect class="fp-box" x={b.x} y={b.y} width={b.w} height={b.h} rx="10" />
                {icon('chip', b.x + (wide ? 14 : 10), b.y + (wide ? 12 : 10))}
                <text class="ft" x={b.x + (wide ? 60 : 54)} y={b.y + (wide ? 37 : 34)}>{e.name}</text>
                <g class="fbar" data-part={`${e.id}-boot`}>
                  <rect x={x} y={y1} width={w} height={boot} rx="4" />
                  <text x={x + 10} y={y1 + boot / 2 + 4}>bootloader</text>
                </g>
                <g class="fbar fbar-app" data-app={e.id}>
                  <rect x={x} y={y2} width={w} height={app} rx="4" />
                  <text x={x + 10} y={y2 + app / 2 + 4} data-app-text>{`application ${e.from}`}</text>
                </g>
                <g class="fbar fbar-dl" data-dl={e.id}>
                  <rect x={x} y={y3} width={w} height={dl} rx="4" />
                  <rect class="fbar-fill" x={x} y={y3} width="0" height={dl} rx="4" data-dl-fill data-w={w} />
                  <text x={x + 10} y={y3 + dl / 2 + 4} data-dl-text>download slot</text>
                </g>
              </g>
            );
          })}

          {/* Wires, over the boxes so their arrowheads stay whole */}
          {L.wires.map((w) => (
            <g class="fw" data-part={w.id}>
              <path class="fw-line" d={d(w.pts)} />
              {w.arrow && <path class="fw-head" d={head(w.pts[0], w.pts[1])} />}
              {w.arrow === 'both' && <path class="fw-head" d={head(w.pts[1], w.pts[0])} />}
              {w.label && w.at && (
                <>
                  {!wide && <rect class="fw-knock" x={w.at[0] - w.label.length * 3.2 - 4} y={w.at[1] - 8} width={w.label.length * 6.4 + 8} height="15" rx="3" />}
                  <text class="fwl" x={w.at[0]} y={w.at[1] + (wide ? 0 : 3.5)} text-anchor="middle">{w.label}</text>
                </>
              )}
            </g>
          ))}

          {
            [0, 1, 2].map((i) => (
              <g class="fpkt" data-packet={i} opacity="0">
                <rect class="fpkt-tag" x="-30" y="-33" width="60" height="22" rx="11" />
                <text x="0" y="-18" text-anchor="middle" />
                <circle class="fpkt-dot" r="5.5" />
              </g>
            ))
          }
        </svg>
      );
    })
  }

  <div class="fleet-foot" aria-hidden="true">
    <p class="fleet-caption" data-caption>{STEPS[0].caption}</p>
  </div>

  <ol class="fleet-static">{STEPS.map((s) => <li>{s.caption}</li>)}</ol>
</div>

<script>
  import { initFleet } from '../scripts/fleet-figure';
  document.querySelectorAll<HTMLElement>('[data-fleet]').forEach(initFleet);
</script>
