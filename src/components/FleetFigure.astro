---
// The Minimal fleet architecture: six blocks and one release running through
// them, step by step (scripts/fleet-figure.ts). Without JS: the blocks, and
// the steps as a list.
import { BLOCKS, EDGES, SLOTS, STEPS } from '../data/fleet';

const d = (pts: readonly (readonly [number, number])[]) => pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x} ${y}`).join(' ');
---

<div class="fleet" data-fleet>
  <div class="fleet-scroll">
    <svg class="fleet-svg" viewBox="0 0 1200 420" role="img" aria-labelledby="fleet-title fleet-desc">
      <title id="fleet-title">Minimal fleet architecture</title>
      <desc id="fleet-desc">{STEPS.map((s, i) => `${i + 1}. ${s.caption}`).join(' ')}</desc>

      {Object.entries(EDGES).map(([id, pts]) => <path class="fe" d={d(pts)} data-edge={id} />)}
      <text class="fe-label" x="900" y="136" text-anchor="middle">CAN</text>

      {
        BLOCKS.map((b) => (
          <g class="fb" data-block={b.id}>
            <rect class="fb-box" x={b.x} y={b.y} width={b.w} height={b.h} rx="12" />
            {b.id === 'ecu' ? (
              <>
                <text class="fb-title" x={b.x + 20} y={b.y + 26}>{b.title}</text>
                <text class="fb-sub" x={b.x + 20} y={b.y + b.h - 14}>{b.sub}</text>
              </>
            ) : (
              <>
                <text class="fb-title" x={b.x + b.w / 2} y={b.y + b.h / 2 - 2} text-anchor="middle">{b.title}</text>
                <text class="fb-sub" x={b.x + b.w / 2} y={b.y + b.h / 2 + 20} text-anchor="middle">{b.sub}</text>
              </>
            )}
          </g>
        ))
      }
      {
        Object.entries(SLOTS).map(([id, s]) => (
          <g class="fs" data-slot={id}>
            <rect x={s.x} y={s.y} width={s.w} height={s.h} rx="7" />
            <text x={s.x + s.w / 2} y={s.y + s.h / 2 + 5} text-anchor="middle">{s.label}</text>
          </g>
        ))
      }

      {
        [0, 1].map((i) => (
          <g class="fpkt" data-packet={i} opacity="0">
            <rect class="fpkt-tag" x="0" y="-11" width="60" height="22" rx="11" />
            <text x="30" y="4" text-anchor="middle" />
          </g>
        ))
      }
    </svg>
  </div>

  <div class="fleet-foot">
    <div class="fleet-dots" role="group" aria-label="Steps">
      {
        STEPS.map((s, i) => (
          <button type="button" class="fleet-dot" data-step={i} aria-label={`Step ${i + 1}: ${s.caption}`}>
            {i + 1}
          </button>
        ))
      }
      <button type="button" class="fleet-play" data-play>Pause</button>
    </div>
    <p class="fleet-caption" aria-live="polite" data-caption>{STEPS[0].caption}</p>
  </div>

  <ol class="fleet-static">{STEPS.map((s) => <li>{s.caption}</li>)}</ol>
</div>

<script>
  import { initFleet } from '../scripts/fleet-figure';
  document.querySelectorAll<HTMLElement>('[data-fleet]').forEach(initFleet);
</script>
