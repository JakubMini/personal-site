---
// A code snippet as text, highlighted at build time by Shiki (bundled with
// Astro, no script shipped). Blank until data/site.ts gives it code. With a
// note, the snippet reads as one ruled block: the problem (and its figure),
// then the fix.
import { Code } from 'astro:components';
import type { Snippet } from '../data/site';
import LeanFigure from './LeanFigure.astro';
import TftpFigure from './TftpFigure.astro';
import FleetFigure from './FleetFigure.astro';
import OtaFigure from './OtaFigure.astro';

interface Props {
  snippet: Snippet;
}

const { snippet } = Astro.props;

// Syntax colours on the page's paper. Every one holds at least 5.4:1 against
// #f3f2ec (WCAG AA for body text), so colour adds meaning without costing legibility.
const paper = {
  name: 'paper',
  type: 'light' as const,
  colors: { 'editor.background': '#f3f2ec', 'editor.foreground': '#0b0f0c' },
  tokenColors: [
    { scope: ['comment', 'punctuation.definition.comment'], settings: { foreground: '#5a5e58', fontStyle: 'italic' } },
    { scope: ['keyword', 'storage.modifier', 'keyword.operator.sizeof'], settings: { foreground: '#b0305c' } },
    { scope: ['storage.type', 'support.type', 'entity.name.type'], settings: { foreground: '#1d6a86' } },
    { scope: ['entity.name.function', 'support.function'], settings: { foreground: '#6440a8' } },
    { scope: ['constant.numeric', 'constant.language', 'constant.character', 'constant.other', 'variable.other.constant', 'keyword.other.unit'], settings: { foreground: '#8a4b14' } },
    { scope: ['string', 'punctuation.definition.string'], settings: { foreground: '#146b37' } },
    { scope: ['meta.preprocessor', 'entity.name.function.preprocessor'], settings: { foreground: '#a1371b' } },
    { scope: ['keyword.operator', 'punctuation'], settings: { foreground: '#3c403a' } },
  ],
};

// `backticks` in a note mark identifiers from the code; odd pieces are code.
const noteParts = snippet.note ? snippet.note.split('`') : [];
const blankLines = Array.from({ length: 8 }, (_, i) => String(i + 1).padStart(2, '0'));
---

<figure class="snippet">
  {
    snippet.note && (
      <div class:list={['snippet-head', { 'snippet-head-wide': snippet.figure === 'tftp' || snippet.figure === 'fleet' || snippet.figure === 'ota' }]}>
        <div class="snippet-explain">
          <p class="snippet-label">{snippet.noteLabel ?? 'The problem'}</p>
          <p class="snippet-note">{noteParts.map((part, i) => (i % 2 ? <code>{part}</code> : part))}</p>
        </div>
        {snippet.figure === 'lean' && <LeanFigure />}
        {
          snippet.figure === 'tftp' && (
            <div class="tftp-host">
              <TftpFigure />
            </div>
          )
        }
        {
          snippet.figure === 'fleet' && (
            <div class="tftp-host">
              <FleetFigure />
            </div>
          )
        }
        {
          snippet.figure === 'ota' && (
            <div class="tftp-host">
              <OtaFigure />
            </div>
          )
        }
      </div>
    )
  }
  {
    snippet.code ? (
      <div class="snippet-window">
        {snippet.note && <p class="snippet-label">The fix</p>}
        <Code code={snippet.code} lang={(snippet.lang ?? 'c') as never} theme={paper} />
      </div>
    ) : (
      !snippet.figure && (
        <div class="snippet-blank" aria-hidden="true">
          {blankLines.map((n) => <span>{n}</span>)}
        </div>
      )
    )
  }
  <figcaption>{snippet.caption}</figcaption>
</figure>
