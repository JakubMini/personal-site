---
// A code snippet as text, highlighted at build time by Shiki (bundled with
// Astro, no script shipped). Blank until data/site.ts gives it code. With a
// note, the snippet reads as one ruled block: the problem (and its figure),
// then the fix.
import { Code } from 'astro:components';
import type { Snippet } from '../data/site';
import LeanFigure from './LeanFigure.astro';
import TftpFigure from './TftpFigure.astro';
import FleetFigure from './FleetFigure.astro';
import OtaFigure from './OtaFigure.astro';

interface Props {
  snippet: Snippet;
}

const { snippet } = Astro.props;

// Syntax colours on the page's paper, and the same set lightened for ink.
// Every one holds at least 5.4:1 against its page (WCAG AA for body text), so
// colour adds meaning without costing legibility. Shiki writes both into each
// token as variables and global.css picks by the scheme (.snippet .astro-code).
const scopes = {
  comment: ['comment', 'punctuation.definition.comment'],
  keyword: ['keyword', 'storage.modifier', 'keyword.operator.sizeof'],
  type: ['storage.type', 'support.type', 'entity.name.type'],
  fn: ['entity.name.function', 'support.function'],
  constant: ['constant.numeric', 'constant.language', 'constant.character', 'constant.other', 'variable.other.constant', 'keyword.other.unit'],
  string: ['string', 'punctuation.definition.string'],
  preprocessor: ['meta.preprocessor', 'entity.name.function.preprocessor'],
  operator: ['keyword.operator', 'punctuation'],
};
const syntax = (name: string, type: 'light' | 'dark', background: string, foreground: string, c: Record<keyof typeof scopes, string>) => ({
  name,
  type,
  colors: { 'editor.background': background, 'editor.foreground': foreground },
  tokenColors: (Object.keys(scopes) as (keyof typeof scopes)[]).map((k) => ({
    scope: scopes[k],
    settings: k === 'comment' ? { foreground: c[k], fontStyle: 'italic' } : { foreground: c[k] },
  })),
});
const paper = syntax('paper', 'light', '#f3f2ec', '#0b0f0c', {
  comment: '#5a5e58', keyword: '#b0305c', type: '#1d6a86', fn: '#6440a8', constant: '#8a4b14', string: '#146b37', preprocessor: '#a1371b', operator: '#3c403a',
});
const ink = syntax('ink', 'dark', '#0b0f0c', '#f3f2ec', {
  comment: '#8e928c', keyword: '#ef7fa3', type: '#6fbde0', fn: '#b79cf0', constant: '#e0a060', string: '#5fd98f', preprocessor: '#ef8f6e', operator: '#c5c7c1',
});

// `backticks` in a note mark identifiers from the code; odd pieces are code.
const noteParts = snippet.note ? snippet.note.split('`') : [];
const blankLines = Array.from({ length: 8 }, (_, i) => String(i + 1).padStart(2, '0'));
---

<figure class="snippet">
  {
    snippet.note && (
      <div class:list={['snippet-head', { 'snippet-head-wide': snippet.figure === 'tftp' || snippet.figure === 'fleet' || snippet.figure === 'ota' }]}>
        <div class="snippet-explain">
          <p class="snippet-label">{snippet.noteLabel ?? 'The problem'}</p>
          <p class="snippet-note">{noteParts.map((part, i) => (i % 2 ? <code>{part}</code> : part))}</p>
        </div>
        {snippet.figure === 'lean' && <LeanFigure />}
        {
          snippet.figure === 'tftp' && (
            <div class="tftp-host">
              <TftpFigure />
            </div>
          )
        }
        {
          snippet.figure === 'fleet' && (
            <div class="tftp-host">
              <FleetFigure />
            </div>
          )
        }
        {
          snippet.figure === 'ota' && (
            <div class="tftp-host">
              <OtaFigure />
            </div>
          )
        }
      </div>
    )
  }
  {
    snippet.code ? (
      <div class="snippet-window">
        {snippet.note && <p class="snippet-label">The fix</p>}
        <Code code={snippet.code} lang={(snippet.lang ?? 'c') as never} themes={{ light: paper, dark: ink }} defaultColor={false} />
      </div>
    ) : (
      !snippet.figure && (
        <div class="snippet-blank" aria-hidden="true">
          {blankLines.map((n) => <span>{n}</span>)}
        </div>
      )
    )
  }
  <figcaption>{snippet.caption}</figcaption>
</figure>
