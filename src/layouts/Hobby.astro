---
// A page of its own (pages/projects.astro, vinyls.astro, photography.astro):
// the top bar with the pages and Home, the page, a short green footer, and the
// record pile and phone bar for once the top bar has gone. `ink` sets the top
// bar on ink, for a page whose hero is.
import Layout from './Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { person, sideB } from '../data/site';

interface Props {
  title: string;
  description: string;
  current: 'projects' | 'vinyls' | 'photography';
  ink?: boolean;
}

const { title, description, current, ink = false } = Astro.props;
const mail = `mailto:${person.email}`;
const year = new Date().getFullYear();
---

<Layout title={`${title} — ${person.name}`} description={description}>
  <div class:list={['hobby', { 'hobby-ink': ink }]} id="top">
    <div class="hobby-top">
      <div class="wrap topbar">
        <a class="wordmark" href="/"><img src="/favicon.svg" alt="" width="28" height="28" />{person.name}</a>
        <nav class="nav" aria-label="Pages">
          {sideB.map((d) => <a href={d.href} aria-current={d.id === current ? 'page' : undefined}>{d.label}</a>)}
          <a href="/">Home</a>
          <ThemeToggle />
        </nav>
      </div>
    </div>
    <main>
      <slot />
    </main>
    <footer class="hobby-foot">
      <div class="wrap">
        <p class="label">Elsewhere</p>
        <p class="contact-links">
          <slot name="elsewhere" />
          <a href="/">Home</a>
          <a href={mail}>{person.email}</a>
        </p>
        <div class="colophon">
          <span>© {year} {person.name}</span>
          <span>{person.location}</span>
        </div>
      </div>
    </footer>
  </div>
  <SiteNav here={current} />
  <script>
    import '../scripts/motion';
  </script>
</Layout>
